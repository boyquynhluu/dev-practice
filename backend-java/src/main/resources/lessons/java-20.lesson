%%% tests
import java.util.List;

class Tests {
    static final class FakeClock implements java.util.function.LongSupplier {
        long now = 1_000;

        public long getAsLong() { return now; }
    }

    static void run(T t) {
        t.test("SET/GET/DEL", () -> {
            MiniRedis r = new MiniRedis(new FakeClock());
            r.set("a", "1");
            T.eq("1", r.get("a"));
            T.eq(null, r.get("missing"));
            T.ok(r.del("a"), "del key có tồn tại trả true");
            T.ok(!r.del("a"), "del lần 2 trả false");
            T.eq(null, r.get("a"));
        });
        t.test("key hết hạn theo TTL", () -> {
            FakeClock c = new FakeClock();
            MiniRedis r = new MiniRedis(c);
            r.set("otp", "123456", 5_000);
            c.now += 4_999;
            T.eq("123456", r.get("otp"));
            c.now += 1;
            T.eq(null, r.get("otp"));
        });
        t.test("PTTL: -2 / -1 / số ms còn lại", () -> {
            FakeClock c = new FakeClock();
            MiniRedis r = new MiniRedis(c);
            T.eq(-2L, r.pttl("x"));
            r.set("x", "v");
            T.eq(-1L, r.pttl("x"));
            T.ok(r.expire("x", 3_000), "expire key tồn tại trả true");
            c.now += 1_000;
            T.eq(2_000L, r.pttl("x"));
            T.ok(!r.expire("nope", 1_000), "expire key không tồn tại trả false");
        });
        t.test("SET lại xoá TTL cũ", () -> {
            FakeClock c = new FakeClock();
            MiniRedis r = new MiniRedis(c);
            r.set("s", "a", 1_000);
            r.set("s", "b");
            c.now += 10_000;
            T.eq("b", r.get("s"));
            T.eq(-1L, r.pttl("s"));
        });
        t.test("INCR: key mới = 1, giữ TTL", () -> {
            FakeClock c = new FakeClock();
            MiniRedis r = new MiniRedis(c);
            T.eq(1L, r.incr("hits"));
            T.eq(2L, r.incr("hits"));
            r.set("rl", "5", 1_000);
            T.eq(6L, r.incr("rl"));
            T.eq(1_000L, r.pttl("rl"));
            c.now += 1_000;
            T.eq("hết TTL thì INCR bắt đầu lại", 1L, r.incr("rl"));
        });
        t.test("INCR trên giá trị không phải số → IllegalStateException", () -> {
            MiniRedis r = new MiniRedis(new FakeClock());
            r.set("name", "an");
            T.throwsEx(IllegalStateException.class, () -> r.incr("name"));
        });
        t.test("Sorted set: bảng xếp hạng", () -> {
            MiniRedis r = new MiniRedis(new FakeClock());
            r.zadd("board", "an", 120);
            r.zadd("board", "binh", 90);
            r.zadd("board", "chi", 150);
            r.zadd("board", "dung", 120);
            T.eq(List.of("chi", "an", "dung"), r.ztop("board", 3));
            r.zadd("board", "binh", 200);
            T.eq(List.of("binh", "chi"), r.ztop("board", 2));
            T.eq(List.of(), r.ztop("missing", 3));
        });
        t.test("WRONGTYPE: zadd vào key String", () -> {
            MiniRedis r = new MiniRedis(new FakeClock());
            r.set("k", "v");
            T.throwsEx(IllegalStateException.class, () -> r.zadd("k", "m", 1));
        });
        t.test("size() không đếm key đã hết hạn", () -> {
            FakeClock c = new FakeClock();
            MiniRedis r = new MiniRedis(c);
            r.set("a", "1");
            r.set("b", "2", 100);
            r.zadd("z", "m", 1);
            T.eq(3, r.size());
            c.now += 100;
            T.eq(2, r.size());
        });
    }
}
%%% solution
import java.util.ArrayList;
import java.util.Comparator;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.function.LongSupplier;

class MiniRedis {
    private record Entry(Object value, long expireAt) {
    }

    private final LongSupplier clock;
    private final Map<String, Entry> data = new HashMap<>();

    MiniRedis(LongSupplier clockMillis) { this.clock = clockMillis; }

    private boolean expired(Entry e, long now) {
        return e.expireAt() >= 0 && now >= e.expireAt();
    }

    private Entry live(String key) {
        Entry e = data.get(key);
        if (e != null && expired(e, clock.getAsLong())) {
            data.remove(key);
            return null;
        }
        return e;
    }

    synchronized void set(String key, String value) {
        data.put(key, new Entry(value, -1));
    }

    synchronized void set(String key, String value, long ttlMillis) {
        data.put(key, new Entry(value, clock.getAsLong() + ttlMillis));
    }

    synchronized String get(String key) {
        Entry e = live(key);
        return e != null && e.value() instanceof String s ? s : null;
    }

    synchronized boolean del(String key) {
        return live(key) != null && data.remove(key) != null;
    }

    synchronized long incr(String key) {
        Entry e = live(key);
        long current = 0;
        if (e != null) {
            if (!(e.value() instanceof String s)) throw new IllegalStateException("WRONGTYPE");
            try {
                current = Long.parseLong(s);
            } catch (NumberFormatException ex) {
                throw new IllegalStateException("ERR value is not an integer");
            }
        }
        long next = current + 1;
        data.put(key, new Entry(Long.toString(next), e == null ? -1 : e.expireAt()));
        return next;
    }

    synchronized boolean expire(String key, long ttlMillis) {
        Entry e = live(key);
        if (e == null) return false;
        data.put(key, new Entry(e.value(), clock.getAsLong() + ttlMillis));
        return true;
    }

    synchronized long pttl(String key) {
        Entry e = live(key);
        if (e == null) return -2;
        if (e.expireAt() < 0) return -1;
        return e.expireAt() - clock.getAsLong();
    }

    @SuppressWarnings("unchecked")
    synchronized void zadd(String key, String member, double score) {
        Entry e = live(key);
        if (e == null) {
            e = new Entry(new HashMap<String, Double>(), -1);
            data.put(key, e);
        }
        if (!(e.value() instanceof Map<?, ?> m)) throw new IllegalStateException("WRONGTYPE");
        ((Map<String, Double>) m).put(member, score);
    }

    @SuppressWarnings("unchecked")
    synchronized List<String> ztop(String key, int n) {
        Entry e = live(key);
        if (e == null) return List.of();
        if (!(e.value() instanceof Map<?, ?> m)) throw new IllegalStateException("WRONGTYPE");
        return ((Map<String, Double>) m).entrySet().stream()
                .sorted(Map.Entry.<String, Double>comparingByValue().reversed().thenComparing(Map.Entry.comparingByKey()))
                .limit(n)
                .map(Map.Entry::getKey)
                .toList();
    }

    synchronized int size() {
        long now = clock.getAsLong();
        data.values().removeIf(e -> expired(e, now));
        return data.size();
    }
}
