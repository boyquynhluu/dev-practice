%%% meta
id: java-13
title: LRU cache và chiến lược cache-aside
level: advanced
topic: Hiệu năng
order: 13
%%% theory
## Cache trong backend

Đọc DB tốn khoảng 1–10ms, đọc RAM chỉ khoảng 100ns. Với dữ liệu đọc nhiều và ít đổi (danh mục, cấu hình, hồ sơ người dùng), cache giảm tải rất lớn.

**Cache-aside** (lazy loading):

```
get(key):
  if cache có  -> trả về (HIT)
  else         -> đọc DB, put vào cache, trả về (MISS)
update(key):   -> ghi DB, rồi XOÁ key khỏi cache (invalidate)
```

## Chính sách loại bỏ: LRU

Khi cache đầy, bỏ phần tử **lâu chưa dùng nhất** (Least Recently Used). Cả `get` lẫn `put` đều tính là "vừa dùng".

Muốn mọi thao tác **O(1)** thì dùng:

- `HashMap<K, Node>` để tìm node trong O(1);
- **danh sách liên kết đôi**: node vừa dùng chuyển lên đầu, khi đầy thì bỏ node ở cuối.

```
head ⇄ [C] ⇄ [A] ⇄ [B] ⇄ tail      (B là ít dùng nhất)
get(B) → head ⇄ [B] ⇄ [C] ⇄ [A] ⇄ tail
```

Java có sẵn cách làm tắt: `new LinkedHashMap<>(16, 0.75f, true)` (accessOrder) kết hợp override `removeEldestEntry`. Bạn được phép dùng nó, nhưng nên thử tự viết bằng danh sách liên kết đôi để hiểu bên trong hoạt động thế nào.

## Thực tế

Ứng dụng thật dùng **Caffeine** (cache trong process) hoặc **Redis** (cache dùng chung giữa nhiều instance). Spring có `@Cacheable`. Có vài vấn đề phải tính:

- dữ liệu cũ (stale): đặt TTL và invalidate khi dữ liệu đổi;
- **cache stampede**: nhiều request cùng miss một key và cùng lao vào DB;
- giới hạn bộ nhớ.
%%% quiz
? Trong LRU, gọi `get(k)` thành công thì…
* k trở thành phần tử mới dùng nhất
- không thay đổi thứ tự
- k bị xoá
? Khi update dữ liệu trong DB theo kiểu cache-aside, cách an toàn thường dùng là gì?
- Giữ nguyên cache
* Xoá key khỏi cache để lần đọc sau nạp lại
- Xoá toàn bộ cache
%%% hints
- Cách nhanh: field `LinkedHashMap<K,V> map = new LinkedHashMap<>(16, 0.75f, true) { protected boolean removeEldestEntry(Map.Entry<K,V> e) { return size() > capacity; } };`
- `getOrLoad`: nếu `map.containsKey(key)` thì tính là hit; ngược lại gọi `loader.apply(key)`, put vào rồi tính là miss.
- `keysMostRecentFirst`: LinkedHashMap duyệt từ cũ nhất đến mới nhất, nên phải đảo ngược lại.
%%% starter
import java.util.*;
import java.util.function.Function;

class LruCache<K, V> {
    private final int capacity;
    private final List<K> order = new ArrayList<>();   // TODO: O(n), chậm!
    private final Map<K, V> values = new HashMap<>();
    private long hits, misses;

    LruCache(int capacity) {
        // TODO: capacity <= 0 -> IllegalArgumentException
        this.capacity = capacity;
    }

    V get(K key) {
        return values.get(key); // TODO: cập nhật thứ tự sử dụng
    }

    void put(K key, V value) {
        values.put(key, value); // TODO: cập nhật thứ tự + loại bỏ khi vượt capacity
    }

    void invalidate(K key) {
        // TODO
    }

    int size() { return values.size(); }

    /** Cache-aside: có thì trả (hit), chưa có thì gọi loader, lưu lại (miss). */
    V getOrLoad(K key, Function<K, V> loader) {
        return loader.apply(key); // TODO
    }

    long hits() { return hits; }

    long misses() { return misses; }

    /** Danh sách key từ mới dùng nhất -> cũ nhất (để debug/test). */
    List<K> keysMostRecentFirst() {
        return List.of(); // TODO
    }
}
%%% tests
import java.util.*;
import java.util.concurrent.atomic.AtomicInteger;

class Tests {
    static void run(T t) {
        t.test("put/get cơ bản", () -> {
            LruCache<String, Integer> c = new LruCache<>(2);
            c.put("a", 1);
            T.eq(1, c.get("a"));
            T.eq(null, c.get("zz"));
        });
        t.test("vượt capacity thì bỏ phần tử lâu chưa dùng nhất", () -> {
            LruCache<String, Integer> c = new LruCache<>(2);
            c.put("a", 1);
            c.put("b", 2);
            c.get("a");          // a mới dùng -> b là cũ nhất
            c.put("c", 3);
            T.eq(null, c.get("b"));
            T.eq(1, c.get("a"));
            T.eq(3, c.get("c"));
            T.eq(2, c.size());
        });
        t.test("put key đã có = cập nhật + làm mới", () -> {
            LruCache<String, Integer> c = new LruCache<>(2);
            c.put("a", 1);
            c.put("b", 2);
            c.put("a", 10);
            c.put("c", 3);
            T.eq(10, c.get("a"));
            T.eq(null, c.get("b"));
        });
        t.test("keysMostRecentFirst", () -> {
            LruCache<Integer, Integer> c = new LruCache<>(3);
            c.put(1, 1);
            c.put(2, 2);
            c.put(3, 3);
            c.get(1);
            T.eq(List.of(1, 3, 2), c.keysMostRecentFirst());
        });
        t.test("invalidate", () -> {
            LruCache<String, Integer> c = new LruCache<>(2);
            c.put("a", 1);
            c.invalidate("a");
            T.eq(null, c.get("a"));
            T.eq(0, c.size());
        });
        t.test("getOrLoad: loader chỉ gọi khi miss, đếm hit/miss", () -> {
            LruCache<Long, String> c = new LruCache<>(10);
            AtomicInteger dbCalls = new AtomicInteger();
            for (int i = 0; i < 5; i++) c.getOrLoad(7L, id -> { dbCalls.incrementAndGet(); return "user" + id; });
            T.eq("user7", c.getOrLoad(7L, id -> "khác"));
            T.eq(1, dbCalls.get());
            T.eq(5L, c.hits());
            T.eq(1L, c.misses());
        });
        t.test("capacity <= 0 -> IllegalArgumentException", () ->
                T.throwsEx(IllegalArgumentException.class, () -> new LruCache<String, String>(0)));
        t.test("hiệu năng: 300.000 thao tác với capacity 20.000 (< 2s)", () -> {
            LruCache<Integer, Integer> c = new LruCache<>(20_000);
            Random r = new Random(1);
            long start = System.nanoTime();
            for (int i = 0; i < 300_000; i++) {
                int k = r.nextInt(40_000);
                if (c.get(k) == null) c.put(k, k);
            }
            long ms = (System.nanoTime() - start) / 1_000_000;
            T.ok(ms < 2000, "mất " + ms + "ms, thao tác chưa phải O(1)");
            T.eq(20_000, c.size());
        });
    }
}
%%% solution
import java.util.*;
import java.util.function.Function;

class LruCache<K, V> {
    private static final class Node<K, V> {
        K key;
        V value;
        Node<K, V> prev, next;
    }

    private final int capacity;
    private final Map<K, Node<K, V>> index = new HashMap<>();
    private final Node<K, V> head = new Node<>(), tail = new Node<>(); // sentinel
    private long hits, misses;

    LruCache(int capacity) {
        if (capacity <= 0) throw new IllegalArgumentException("capacity phải > 0");
        this.capacity = capacity;
        head.next = tail;
        tail.prev = head;
    }

    V get(K key) {
        Node<K, V> n = index.get(key);
        if (n == null) return null;
        moveToFront(n);
        return n.value;
    }

    void put(K key, V value) {
        Node<K, V> n = index.get(key);
        if (n != null) {
            n.value = value;
            moveToFront(n);
            return;
        }
        n = new Node<>();
        n.key = key;
        n.value = value;
        index.put(key, n);
        addFront(n);
        if (index.size() > capacity) {
            Node<K, V> lru = tail.prev;
            unlink(lru);
            index.remove(lru.key);
        }
    }

    void invalidate(K key) {
        Node<K, V> n = index.remove(key);
        if (n != null) unlink(n);
    }

    int size() { return index.size(); }

    V getOrLoad(K key, Function<K, V> loader) {
        Node<K, V> n = index.get(key);
        if (n != null) {
            hits++;
            moveToFront(n);
            return n.value;
        }
        misses++;
        V v = loader.apply(key);
        put(key, v);
        return v;
    }

    long hits() { return hits; }

    long misses() { return misses; }

    List<K> keysMostRecentFirst() {
        List<K> out = new ArrayList<>();
        for (Node<K, V> n = head.next; n != tail; n = n.next) out.add(n.key);
        return out;
    }

    private void moveToFront(Node<K, V> n) {
        unlink(n);
        addFront(n);
    }

    private void addFront(Node<K, V> n) {
        n.prev = head;
        n.next = head.next;
        head.next.prev = n;
        head.next = n;
    }

    private void unlink(Node<K, V> n) {
        n.prev.next = n.next;
        n.next.prev = n.prev;
    }
}
