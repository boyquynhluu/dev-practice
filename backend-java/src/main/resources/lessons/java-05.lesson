%%% tests
import java.io.BufferedReader;
import java.io.StringReader;
import java.util.Map;

class Tests {
    static class TrackedReader extends BufferedReader {
        boolean closed;

        TrackedReader(String s) { super(new StringReader(s)); }

        @Override
        public void close() throws java.io.IOException {
            closed = true;
            super.close();
        }
    }

    static void run(T t) {
        t.test("parseAge hợp lệ (có khoảng trắng)", () -> T.eq(30, Solution.parseAge(" 30 ")));
        t.test("parseAge rỗng", () -> {
            ValidationException e = T.throwsEx(ValidationException.class, () -> Solution.parseAge("  "));
            T.eq("bắt buộc", e.errors().get("age"));
        });
        t.test("parseAge không phải số, giữ cause", () -> {
            ValidationException e = T.throwsEx(ValidationException.class, () -> Solution.parseAge("abc"));
            T.eq("phải là số", e.errors().get("age"));
            T.ok(e.getCause() instanceof NumberFormatException, "cause phải là NumberFormatException gốc");
        });
        t.test("parseAge ngoài khoảng", () -> {
            ValidationException e = T.throwsEx(ValidationException.class, () -> Solution.parseAge("151"));
            T.eq("ngoài khoảng 0-150", e.errors().get("age"));
        });
        t.test("register hợp lệ", () -> T.eq(new User("An", "an@x.vn", 20),
                Solution.register(Map.of("name", "An", "email", "an@x.vn", "age", "20"))));
        t.test("register gom đủ 3 lỗi", () -> {
            ValidationException e = T.throwsEx(ValidationException.class,
                    () -> Solution.register(Map.of("name", " ", "email", "sai-email", "age", "x")));
            T.eq(3, e.errors().size());
            T.ok(e.errors().containsKey("name") && e.errors().containsKey("email") && e.errors().containsKey("age"),
                    "thiếu field lỗi: " + e.errors());
        });
        t.test("register thiếu field", () -> {
            ValidationException e = T.throwsEx(ValidationException.class, () -> Solution.register(Map.of("name", "An")));
            T.eq(2, e.errors().size());
        });
        t.test("sumLines cộng và đóng reader", () -> {
            TrackedReader r = new TrackedReader("1\n\n2\n 3 \n");
            T.eq(6L, Solution.sumLines(r));
            T.ok(r.closed, "reader chưa được đóng");
        });
        t.test("sumLines lỗi vẫn đóng reader, báo đúng dòng", () -> {
            TrackedReader r = new TrackedReader("1\nabc\n");
            ValidationException e = T.throwsEx(ValidationException.class, () -> Solution.sumLines(r));
            T.ok(e.errors().containsKey("line 2"), "phải báo 'line 2', nhận: " + e.errors());
            T.ok(r.closed, "reader chưa được đóng khi có lỗi");
        });
    }
}
%%% solution
import java.io.BufferedReader;
import java.io.IOException;
import java.io.UncheckedIOException;
import java.util.LinkedHashMap;
import java.util.Map;

class ValidationException extends RuntimeException {
    private final Map<String, String> errors;

    ValidationException(Map<String, String> errors) {
        super("Dữ liệu không hợp lệ: " + errors);
        this.errors = Map.copyOf(errors);
    }

    ValidationException(String field, String message, Throwable cause) {
        super(field + ": " + message, cause);
        this.errors = Map.of(field, message);
    }

    Map<String, String> errors() { return errors; }
}

record User(String name, String email, int age) {
}

class Solution {
    static int parseAge(String raw) {
        if (raw == null || raw.isBlank()) throw new ValidationException(Map.of("age", "bắt buộc"));
        int age;
        try {
            age = Integer.parseInt(raw.strip());
        } catch (NumberFormatException e) {
            throw new ValidationException("age", "phải là số", e);
        }
        if (age < 0 || age > 150) throw new ValidationException(Map.of("age", "ngoài khoảng 0-150"));
        return age;
    }

    static User register(Map<String, String> form) {
        Map<String, String> errors = new LinkedHashMap<>();
        String name = form.get("name");
        if (name == null || name.isBlank()) errors.put("name", "bắt buộc");
        String email = form.get("email");
        if (email == null || !email.matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$")) errors.put("email", "email không hợp lệ");
        int age = 0;
        try {
            age = parseAge(form.get("age"));
        } catch (ValidationException e) {
            errors.putAll(e.errors());
        }
        if (!errors.isEmpty()) throw new ValidationException(errors);
        return new User(name.strip(), email, age);
    }

    static long sumLines(BufferedReader reader) {
        try (reader) {
            long sum = 0;
            int lineNo = 0;
            String line;
            while ((line = reader.readLine()) != null) {
                lineNo++;
                if (line.isBlank()) continue;
                try {
                    sum += Long.parseLong(line.strip());
                } catch (NumberFormatException e) {
                    throw new ValidationException("line " + lineNo, "không phải số: " + line, e);
                }
            }
            return sum;
        } catch (IOException e) {
            throw new UncheckedIOException(e);
        }
    }
}
