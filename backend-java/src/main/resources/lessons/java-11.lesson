%%% tests
import java.time.Duration;
import java.util.*;
import java.util.concurrent.*;
import java.util.concurrent.atomic.AtomicInteger;
import java.util.function.Supplier;

class Tests {
    static void sleep(long ms) {
        try {
            Thread.sleep(ms);
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        }
    }

    static void run(T t) {
        t.test("fetchAll đúng thứ tự", () -> {
            ExecutorService pool = Executors.newFixedThreadPool(3);
            try {
                List<Callable<Long>> tasks = List.of(() -> { sleep(150); return 1L; }, () -> 2L, () -> { sleep(50); return 3L; });
                T.eq(List.of(1L, 2L, 3L), Solution.fetchAll(tasks, pool));
            } finally {
                pool.shutdown();
            }
        });
        t.test("fetchAll chạy song song (4 x 300ms < 800ms)", () -> {
            ExecutorService pool = Executors.newFixedThreadPool(4);
            try {
                List<Callable<Long>> tasks = new ArrayList<>();
                for (long i = 0; i < 4; i++) {
                    long v = i;
                    tasks.add(() -> { sleep(300); return v; });
                }
                long start = System.nanoTime();
                Solution.fetchAll(tasks, pool);
                long ms = (System.nanoTime() - start) / 1_000_000;
                T.ok(ms < 800, "mất " + ms + "ms, có vẻ vẫn chạy tuần tự");
            } finally {
                pool.shutdown();
            }
        });
        t.test("bestPrice lấy min", () -> {
            List<Supplier<Long>> s = List.of(() -> 300L, () -> 100L, () -> 200L);
            T.eq(OptionalLong.of(100), Solution.bestPrice(s, Duration.ofSeconds(1)));
        });
        t.test("bestPrice bỏ qua nhà cung cấp lỗi và chậm", () -> {
            List<Supplier<Long>> s = List.of(
                    () -> { throw new IllegalStateException("down"); },
                    () -> { sleep(2000); return 1L; },
                    () -> { sleep(50); return 500L; });
            long start = System.nanoTime();
            OptionalLong r = Solution.bestPrice(s, Duration.ofMillis(300));
            long ms = (System.nanoTime() - start) / 1_000_000;
            T.eq(OptionalLong.of(500), r);
            T.ok(ms < 1500, "phải trả về sau khoảng timeout, nhưng mất " + ms + "ms");
        });
        t.test("bestPrice tất cả lỗi -> empty", () ->
                T.eq(OptionalLong.empty(), Solution.bestPrice(List.of(() -> { throw new RuntimeException(); }), Duration.ofMillis(200))));
        t.test("withRetry thành công ở lần 3", () -> {
            AtomicInteger calls = new AtomicInteger();
            String r = Solution.withRetry(() -> {
                if (calls.incrementAndGet() < 3) throw new java.io.IOException("mạng chập chờn");
                return "ok";
            }, 5);
            T.eq("ok", r);
            T.eq(3, calls.get());
        });
        t.test("withRetry hết lượt -> RuntimeException có cause", () -> {
            AtomicInteger calls = new AtomicInteger();
            RuntimeException e = T.throwsEx(RuntimeException.class, () -> Solution.withRetry(() -> {
                calls.incrementAndGet();
                throw new java.io.IOException("lần " + calls.get());
            }, 3));
            T.eq(3, calls.get());
            T.ok(e.getCause() instanceof java.io.IOException, "cause phải là lỗi gốc");
            T.eq("lần 3", e.getCause().getMessage());
        });
    }
}
%%% solution
import java.time.Duration;
import java.util.*;
import java.util.concurrent.*;
import java.util.function.Supplier;

class Solution {
    static List<Long> fetchAll(List<Callable<Long>> tasks, ExecutorService pool) throws Exception {
        List<Long> out = new ArrayList<>();
        for (Future<Long> f : pool.invokeAll(tasks)) out.add(f.get());
        return out;
    }

    static OptionalLong bestPrice(List<Supplier<Long>> suppliers, Duration timeout) {
        ExecutorService pool = Executors.newFixedThreadPool(Math.max(1, suppliers.size()));
        try {
            List<CompletableFuture<Long>> fs = suppliers.stream()
                    .map(s -> CompletableFuture.supplyAsync(s, pool)
                            .completeOnTimeout(null, timeout.toMillis(), TimeUnit.MILLISECONDS)
                            .exceptionally(e -> null))
                    .toList();
            return fs.stream().map(CompletableFuture::join).filter(Objects::nonNull)
                    .mapToLong(Long::longValue).min();
        } finally {
            pool.shutdownNow();
        }
    }

    static <T> T withRetry(Callable<T> task, int maxAttempts) {
        Exception last = null;
        for (int i = 1; i <= maxAttempts; i++) {
            try {
                return task.call();
            } catch (Exception e) {
                last = e;
            }
        }
        throw new RuntimeException("Thất bại sau " + maxAttempts + " lần", last);
    }
}
