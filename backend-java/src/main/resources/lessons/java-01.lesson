%%% tests
class Tests {
    static void run(T t) {
        t.test("isPalindrome: câu có dấu câu", () -> T.eq(true, Solution.isPalindrome("A man, a plan, a canal: Panama")));
        t.test("isPalindrome: không đối xứng", () -> T.eq(false, Solution.isPalindrome("race a car")));
        t.test("isPalindrome: chuỗi rỗng / chỉ dấu câu", () -> {
            T.eq(true, Solution.isPalindrome(""));
            T.eq(true, Solution.isPalindrome(" .,"));
        });
        t.test("compress: cơ bản", () -> T.eq("a3b1c2", Solution.compress("aaabcc")));
        t.test("compress: dài hơn thì giữ nguyên", () -> T.eq("abc", Solution.compress("abc")));
        t.test("compress: chuỗi rỗng", () -> T.eq("", Solution.compress("")));
        t.test("countWords: nhiều khoảng trắng", () -> T.eq(2, Solution.countWords("  hello   world ")));
        t.test("countWords: rỗng / toàn khoảng trắng", () -> {
            T.eq(0, Solution.countWords(""));
            T.eq(0, Solution.countWords("    "));
        });
    }
}
%%% solution
class Solution {
    static boolean isPalindrome(String s) {
        int i = 0, j = s.length() - 1;
        while (i < j) {
            char a = s.charAt(i), b = s.charAt(j);
            if (!Character.isLetterOrDigit(a)) { i++; continue; }
            if (!Character.isLetterOrDigit(b)) { j--; continue; }
            if (Character.toLowerCase(a) != Character.toLowerCase(b)) return false;
            i++;
            j--;
        }
        return true;
    }

    static String compress(String s) {
        StringBuilder sb = new StringBuilder();
        int i = 0;
        while (i < s.length()) {
            char c = s.charAt(i);
            int j = i;
            while (j < s.length() && s.charAt(j) == c) j++;
            sb.append(c).append(j - i);
            i = j;
        }
        return sb.length() <= s.length() ? sb.toString() : s;
    }

    static int countWords(String s) {
        String t = s.strip();
        return t.isEmpty() ? 0 : t.split("\\s+").length;
    }

    public static void main(String[] args) {
        System.out.println(isPalindrome("A man, a plan, a canal: Panama"));
        System.out.println(compress("aaabcc"));
    }
}
