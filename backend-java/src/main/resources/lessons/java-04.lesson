%%% tests
import java.util.*;

class Tests {
    static void run(T t) {
        t.test("wordFreq cơ bản", () -> {
            Map<String, Integer> f = Solution.wordFreq("Hello, hello world!");
            T.eq(2, f.get("hello"));
            T.eq(1, f.get("world"));
            T.eq(2, f.size());
        });
        t.test("wordFreq tiếng Việt có dấu", () -> {
            Map<String, Integer> f = Solution.wordFreq("Đường xa, đường gần.");
            T.eq(2, f.get("đường"));
        });
        t.test("wordFreq chuỗi rỗng", () -> T.eq(0, Solution.wordFreq("  ...  ").size()));
        t.test("topK theo tần suất rồi chữ cái", () ->
                T.eq(List.of("b", "a", "c"), Solution.topK("a b c b a b d c", 3)));
        t.test("topK k lớn hơn số từ", () -> T.eq(List.of("x"), Solution.topK("x x", 5)));
        t.test("dedupeKeepOrder", () -> T.eq(List.of(3, 1, 2), Solution.dedupeKeepOrder(List.of(3, 1, 3, 2, 1))));
        t.test("dedupeKeepOrder không sửa list đầu vào", () -> {
            List<Integer> in = new ArrayList<>(List.of(1, 1, 2));
            Solution.dedupeKeepOrder(in);
            T.eq(List.of(1, 1, 2), in);
        });
        t.test("groupByDomain", () -> {
            Map<String, List<String>> g = Solution.groupByDomain(
                    List.of("an@Gmail.com", "binh@corp.vn", "bad-email", "chi@gmail.com"));
            T.eq(List.of("corp.vn", "gmail.com"), new ArrayList<>(g.keySet()));
            T.eq(List.of("an@Gmail.com", "chi@gmail.com"), g.get("gmail.com"));
        });
    }
}
%%% solution
import java.util.*;

class Solution {
    static Map<String, Integer> wordFreq(String text) {
        Map<String, Integer> freq = new HashMap<>();
        for (String w : text.toLowerCase().split("[^\\p{L}\\p{N}]+")) {
            if (!w.isEmpty()) freq.merge(w, 1, Integer::sum);
        }
        return freq;
    }

    static List<String> topK(String text, int k) {
        return wordFreq(text).entrySet().stream()
                .sorted(Map.Entry.<String, Integer>comparingByValue().reversed()
                        .thenComparing(Map.Entry.comparingByKey()))
                .limit(k)
                .map(Map.Entry::getKey)
                .toList();
    }

    static List<Integer> dedupeKeepOrder(List<Integer> items) {
        return new ArrayList<>(new LinkedHashSet<>(items));
    }

    static Map<String, List<String>> groupByDomain(List<String> emails) {
        Map<String, List<String>> out = new TreeMap<>();
        for (String e : emails) {
            int at = e.indexOf('@');
            if (at < 0) continue;
            out.computeIfAbsent(e.substring(at + 1).toLowerCase(), d -> new ArrayList<>()).add(e);
        }
        return out;
    }
}
