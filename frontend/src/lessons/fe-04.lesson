%%% theory
## Scope

- `let`/`const` có **block scope**, tức chỉ sống trong cặp `{ }`. `var` có function scope và bị hoisting, nên **đừng dùng `var`**.
- Ở bên trong, hàm nhìn thấy được biến của bên ngoài, còn bên ngoài thì không nhìn thấy biến của hàm.

## Closure

Một hàm **nhớ** các biến ở nơi nó được tạo ra, kể cả khi hàm bên ngoài đã chạy xong:

```js
function createCounter(start = 0) {
  let count = start;                 // biến "riêng tư"
  return {
    inc: () => ++count,
    get: () => count,
  };
}
const c = createCounter();
c.inc(); c.inc(); c.get(); // 2  (không ai sửa được count từ bên ngoài)
```

Closure có ở khắp nơi: event handler, `setTimeout`, các hook của React (`useState` trả về một hàm closure), middleware.

## Bẫy closure trong vòng lặp

```js
for (var i = 0; i < 3; i++) setTimeout(() => console.log(i)); // 3 3 3
for (let i = 0; i < 3; i++) setTimeout(() => console.log(i)); // 0 1 2  (let tạo biến mới mỗi vòng)
```

## `this`

- Hàm thường: `this` phụ thuộc **cách gọi** (`obj.fn()` thì `this` là `obj`). Gọi tách rời `const f = obj.fn; f()` thì `this` là `undefined` (strict mode).
- **Arrow function** không có `this` riêng, nó lấy `this` của nơi bao quanh. Vì vậy arrow function hợp để làm callback.
- Gắn cố định `this` bằng `fn.bind(obj)`.

## Memoize: closure giữ cache

```js
function memoize(fn) {
  const cache = new Map();
  return (arg) => cache.has(arg) ? cache.get(arg) : (cache.set(arg, fn(arg)), cache.get(arg));
}
```
%%% quiz
? `for (var i = 0; i < 3; i++) setTimeout(() => console.log(i))` in ra gì?
- 0 1 2
* 3 3 3
- undefined ×3
? Arrow function lấy `this` từ đâu?
- Từ object gọi nó
* Từ scope bao quanh nơi nó được định nghĩa
- Luôn là window
%%% hints
- once: dùng biến `called` và `result` trong closure.
- memoize: key là `JSON.stringify(args)`, cache là một `Map`.
- createBankAccount: giữ `balance` và `history` trong closure; `getHistory` trả **bản sao** (`[...history]`).
- Bài `this`: trong constructor viết `this.handle = this.handle.bind(this)`, hoặc đổi `handle` thành class field dạng arrow function.
%%% starter
/** Hàm chỉ chạy lần đầu; các lần sau trả lại kết quả lần đầu */
function once(fn) {
  return fn; // TODO
}

/** Cache theo toàn bộ tham số; memoized.calls = số lần fn thật sự chạy */
function memoize(fn) {
  return fn; // TODO
}

/** balance riêng tư; withdraw quá số dư -> throw Error('Không đủ tiền') */
function createBankAccount(initial = 0) {
  return {
    balance: initial, // TODO: lộ ra ngoài, ai cũng sửa được!
    deposit(x) { this.balance += x; },
    withdraw(x) { this.balance -= x; },
    getBalance() { return this.balance; },
    getHistory() { return []; },
  };
}

class Clicker {
  constructor() {
    this.count = 0;
  }

  handle() { // TODO: mất `this` khi truyền làm callback
    this.count++;
  }
}

/** Trả mảng 3 hàm, hàm thứ i trả về i */
function makeGetters() {
  const fns = [];
  for (var i = 0; i < 3; i++) fns.push(() => i); // TODO
  return fns;
}
%%% tests
test('once chỉ chạy một lần', () => {
  let n = 0;
  const init = once((x) => { n++; return x * 2; });
  expect(init(5)).toBe(10);
  expect(init(100)).toBe(10);
  expect(n).toBe(1);
});

test('memoize theo nhiều tham số', () => {
  const add = memoize((a, b) => a + b);
  expect(add(1, 2)).toBe(3);
  expect(add(1, 2)).toBe(3);
  expect(add(2, 1)).toBe(3);
  expect(add.calls).toBe(2);
});

test('bank account: balance không lộ ra ngoài', () => {
  const acc = createBankAccount(100);
  expect(acc.balance).toBeUndefined();
  acc.deposit(50);
  acc.withdraw(30);
  expect(acc.getBalance()).toBe(120);
});

test('bank account: không rút quá số dư, có lịch sử (bản sao)', () => {
  const acc = createBankAccount(10);
  expect(() => acc.withdraw(11)).toThrow('Không đủ tiền');
  acc.deposit(5);
  const h = acc.getHistory();
  expect(h).toEqual([{ type: 'deposit', amount: 5 }]);
  h.push('hack');
  expect(acc.getHistory()).toHaveLength(1);
});

test('this không bị mất khi truyền handle làm callback', () => {
  const c = new Clicker();
  const cb = c.handle;
  cb();
  [1, 2].forEach(c.handle);
  expect(c.count).toBe(3);
});

test('makeGetters: closure trong vòng lặp', () => {
  expect(makeGetters().map((f) => f())).toEqual([0, 1, 2]);
});
%%% solution
function once(fn) {
  let called = false;
  let result;
  return (...args) => {
    if (!called) {
      called = true;
      result = fn(...args);
    }
    return result;
  };
}

function memoize(fn) {
  const cache = new Map();
  const memo = (...args) => {
    const key = JSON.stringify(args);
    if (!cache.has(key)) {
      memo.calls++;
      cache.set(key, fn(...args));
    }
    return cache.get(key);
  };
  memo.calls = 0;
  return memo;
}

function createBankAccount(initial = 0) {
  let balance = initial;
  const history = [];
  return {
    deposit(x) {
      balance += x;
      history.push({ type: 'deposit', amount: x });
    },
    withdraw(x) {
      if (x > balance) throw new Error('Không đủ tiền');
      balance -= x;
      history.push({ type: 'withdraw', amount: x });
    },
    getBalance: () => balance,
    getHistory: () => [...history],
  };
}

class Clicker {
  count = 0;

  handle = () => {
    this.count++;
  };
}

function makeGetters() {
  const fns = [];
  for (let i = 0; i < 3; i++) fns.push(() => i);
  return fns;
}
