console.log(summarize(ORDERS));
%%% tests
test('orderTotal', () => {
  expect(orderTotal(ORDERS[0])).toBe(130);
  expect(orderTotal({ items: [] })).toBe(0);
});

test('summarize chỉ tính đơn paid', () => {
  expect(summarize(ORDERS)).toEqual({ count: 2, revenue: 220, maxOrderId: 1 });
});

test('summarize mảng rỗng', () => {
  expect(summarize([])).toEqual({ count: 0, revenue: 0, maxOrderId: null });
});

test('topProducts', () => {
  expect(topProducts(ORDERS, 2)).toEqual([{ sku: 'B', qty: 3 }, { sku: 'C', qty: 3 }]);
  expect(topProducts(ORDERS, 10)).toHaveLength(3);
});

test('chunk', () => {
  expect(chunk([1, 2, 3, 4, 5], 2)).toEqual([[1, 2], [3, 4], [5]]);
  expect(chunk([], 3)).toEqual([]);
});

test('idsByTotalDesc không sửa mảng gốc', () => {
  const copy = ORDERS.map((o) => o.id);
  expect(idsByTotalDesc(ORDERS)).toEqual([2, 1, 3]);
  expect(ORDERS.map((o) => o.id)).toEqual(copy);
});
%%% solution
const ORDERS = [
  { id: 1, status: 'paid', items: [{ sku: 'A', qty: 2, price: 50 }, { sku: 'B', qty: 1, price: 30 }] },
  { id: 2, status: 'cancelled', items: [{ sku: 'A', qty: 5, price: 50 }] },
  { id: 3, status: 'paid', items: [{ sku: 'C', qty: 3, price: 10 }, { sku: 'B', qty: 2, price: 30 }] },
];

function orderTotal(order) {
  return order.items.reduce((sum, it) => sum + it.qty * it.price, 0);
}

function summarize(orders) {
  const paid = orders.filter((o) => o.status === 'paid');
  let max = null;
  for (const o of paid) if (max === null || orderTotal(o) > orderTotal(max)) max = o;
  return {
    count: paid.length,
    revenue: paid.reduce((s, o) => s + orderTotal(o), 0),
    maxOrderId: max ? max.id : null,
  };
}

function topProducts(orders, n) {
  const qty = {};
  for (const it of orders.filter((o) => o.status === 'paid').flatMap((o) => o.items)) {
    qty[it.sku] = (qty[it.sku] ?? 0) + it.qty;
  }
  return Object.entries(qty)
    .map(([sku, q]) => ({ sku, qty: q }))
    .toSorted((a, b) => b.qty - a.qty || a.sku.localeCompare(b.sku))
    .slice(0, n);
}

function chunk(arr, size) {
  const out = [];
  for (let i = 0; i < arr.length; i += size) out.push(arr.slice(i, i + size));
  return out;
}

function idsByTotalDesc(orders) {
  return orders.toSorted((a, b) => orderTotal(b) - orderTotal(a)).map((o) => o.id);
}

console.log(summarize(ORDERS));
