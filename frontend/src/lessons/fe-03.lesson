%%% tests
test('setIn tạo object mới, không sửa gốc', () => {
  const a = { x: { y: 1 }, z: { k: 1 } };
  const b = setIn(a, ['x', 'w'], 2);
  expect(b).toEqual({ x: { y: 1, w: 2 }, z: { k: 1 } });
  expect(a).toEqual({ x: { y: 1 }, z: { k: 1 } });
});

test('setIn giữ tham chiếu nhánh không đổi (structural sharing)', () => {
  const a = { x: { y: 1 }, z: { k: 1 } };
  const b = setIn(a, ['x', 'y'], 5);
  expect(b === a).toBe(false);
  expect(b.z === a.z).toBe(true);
});

test('setIn tạo đường dẫn mới', () => {
  expect(setIn({}, ['a', 'b', 'c'], 1)).toEqual({ a: { b: { c: 1 } } });
});

test('pick / omit', () => {
  const u = { id: 1, name: 'An', password: 'x' };
  expect(pick(u, ['id', 'name', 'nope'])).toEqual({ id: 1, name: 'An' });
  expect(omit(u, ['password'])).toEqual({ id: 1, name: 'An' });
  expect(u.password).toBe('x');
});

test('toggleTodo bất biến', () => {
  const todos = [{ id: 1, done: false }, { id: 2, done: false }];
  const next = toggleTodo(todos, 2);
  expect(next).toEqual([{ id: 1, done: false }, { id: 2, done: true }]);
  expect(todos[1].done).toBe(false);
  expect(next[0] === todos[0]).toBe(true);
});

test('cityOf an toàn khi thiếu dữ liệu', () => {
  expect(cityOf({ profile: { address: { city: 'HN' } } })).toBe('HN');
  expect(cityOf({})).toBe('N/A');
  expect(cityOf(null)).toBe('N/A');
});
%%% solution
function setIn(obj, path, value) {
  const [k, ...rest] = path;
  return { ...obj, [k]: rest.length ? setIn(obj?.[k] ?? {}, rest, value) : value };
}

function pick(obj, keys) {
  return Object.fromEntries(keys.filter((k) => k in obj).map((k) => [k, obj[k]]));
}

function omit(obj, keys) {
  return Object.fromEntries(Object.entries(obj).filter(([k]) => !keys.includes(k)));
}

function toggleTodo(todos, id) {
  return todos.map((t) => (t.id === id ? { ...t, done: !t.done } : t));
}

function cityOf(user) {
  return user?.profile?.address?.city ?? 'N/A';
}
