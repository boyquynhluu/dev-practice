async function retry(fn, times = 3, delay = 10) {
  return fn(); // TODO
}

/** Chạy SONG SONG mọi loader, trả { ok: [giá trị...], failed: [message...] } giữ thứ tự */
async function settleAll(loaders) {
  return { ok: [], failed: [] }; // TODO
}

/** Chạy fn lần lượt từng phần tử (tuần tự), trả mảng kết quả */
async function mapSeries(items, fn) {
  const out = [];
  items.forEach(async (x) => out.push(await fn(x))); // TODO: không chờ!
  return out;
}

/** Tải user và orders SONG SONG: { user, orders } */
async function loadDashboard(api) {
  const user = await api.getUser();
  const orders = await api.getOrders(); // TODO: đang tuần tự
