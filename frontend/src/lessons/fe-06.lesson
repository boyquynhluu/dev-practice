%%% tests
test('withTimeout: xong kịp', async () => {
  expect(await withTimeout(wait(10).then(() => 'ok'), 200)).toBe('ok');
});

test('withTimeout: quá giờ', async () => {
  await expect(withTimeout(wait(300), 30)).rejects.toThrow('Timeout');
});

test('retry thành công ở lần 3', async () => {
  let n = 0;
  const r = await retry(async () => {
    n++;
    if (n < 3) throw new Error(`lỗi ${n}`);
    return 'done';
  }, 5, 1);
  expect(r).toBe('done');
  expect(n).toBe(3);
});

test('retry hết lượt ném lỗi cuối', async () => {
  let n = 0;
  await expect(retry(async () => { n++; throw new Error(`lỗi ${n}`); }, 2, 1)).rejects.toThrow('lỗi 2');
  expect(n).toBe(2);
});

test('settleAll gom kết quả và lỗi', async () => {
  const r = await settleAll([() => wait(5).then(() => 1), () => Promise.reject(new Error('down')), async () => 3]);
  expect(r).toEqual({ ok: [1, 3], failed: ['down'] });
});

test('settleAll chạy song song', async () => {
  const start = Date.now();
  await settleAll([() => wait(100), () => wait(100), () => wait(100)]);
  expect(Date.now() - start).toBeLessThan(250);
});

test('mapSeries chờ từng phần tử, đúng thứ tự', async () => {
  const log = [];
  const r = await mapSeries([30, 10, 20], async (ms) => {
    log.push(`start ${ms}`);
    await wait(ms);
    log.push(`end ${ms}`);
    return ms * 2;
  });
  expect(r).toEqual([60, 20, 40]);
  expect(log).toEqual(['start 30', 'end 30', 'start 10', 'end 10', 'start 20', 'end 20']);
});

test('loadDashboard song song', async () => {
  const api = { getUser: () => wait(100).then(() => 'an'), getOrders: () => wait(100).then(() => [1]) };
  const start = Date.now();
  expect(await loadDashboard(api)).toEqual({ user: 'an', orders: [1] });
  expect(Date.now() - start).toBeLessThan(180);
});
%%% solution
const wait = (ms) => new Promise((r) => setTimeout(r, ms));

async function withTimeout(promise, ms) {
  let timer;
  const timeout = new Promise((_, reject) => {
    timer = setTimeout(() => reject(new Error('Timeout')), ms);
  });
  try {
    return await Promise.race([promise, timeout]);
  } finally {
    clearTimeout(timer);
  }
}

async function retry(fn, times = 3, delay = 10) {
  let last;
  for (let i = 0; i < times; i++) {
    try {
      return await fn();
    } catch (e) {
      last = e;
      if (i < times - 1) await wait(delay);
    }
  }
  throw last;
}

async function settleAll(loaders) {
  const results = await Promise.allSettled(loaders.map((load) => load()));
  return {
    ok: results.filter((r) => r.status === 'fulfilled').map((r) => r.value),
    failed: results.filter((r) => r.status === 'rejected').map((r) => r.reason?.message ?? String(r.reason)),
  };
}

async function mapSeries(items, fn) {
  const out = [];
  for (const x of items) out.push(await fn(x));
  return out;
}

async function loadDashboard(api) {
  const [user, orders] = await Promise.all([api.getUser(), api.getOrders()]);
  return { user, orders };
}
