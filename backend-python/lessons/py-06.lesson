%%% tests
from itertools import count

from checker import test, eq, ok, raises
from solution import *


@test("chunked")
def _():
    eq([[0, 1], [2, 3], [4]], list(chunked(range(5), 2)))
    eq([], list(chunked([], 3)))


@test("chunked là generator (lazy, dùng được với chuỗi vô hạn)")
def _():
    gen = chunked(count(), 3)
    eq([0, 1, 2], next(gen))
    eq([3, 4, 5], next(gen))


@test("chunked validate ngay khi gọi")
def _():
    raises(ValueError, chunked, [1], 0)


@test("all_items duyệt hết các trang")
def _():
    pages = {1: {"items": [1, 2], "next": 2}, 2: {"items": [3], "next": 3}, 3: {"items": [], "next": None}}
    eq([1, 2, 3], list(all_items(lambda p: pages[p])))


@test("all_items lazy: break sớm thì không gọi trang sau")
def _():
    calls = []

    def fetch(p):
        calls.append(p)
        return {"items": [p * 10, p * 10 + 1], "next": p + 1}

    eq([10, 11, 20], first_n(all_items(fetch), 3))
    eq([1, 2], calls)


@test("sliding_window")
def _():
    eq([(1, 2, 3), (2, 3, 4)], list(sliding_window([1, 2, 3, 4], 3)))
    eq([], list(sliding_window([1], 2)))


@test("Countdown theo giao thức iterator")
def _():
    eq([3, 2, 1], list(Countdown(3)))
    it = iter(Countdown(1))
    eq(1, next(it))
    raises(StopIteration, next, it)
%%% solution
from collections import deque
from itertools import islice


def chunked(iterable, size: int):
    if size <= 0:
        raise ValueError("size phải > 0")

    def _gen():
        buf = []
        for x in iterable:
            buf.append(x)
            if len(buf) == size:
                yield buf
                buf = []
        if buf:
            yield buf

    return _gen()


def all_items(fetch_page):
    page = 1
    while page is not None:
        data = fetch_page(page)
        yield from data["items"]
        page = data["next"]


def sliding_window(iterable, n: int):
    win = deque(maxlen=n)
    for x in iterable:
        win.append(x)
        if len(win) == n:
            yield tuple(win)


class Countdown:
    def __init__(self, start: int):
        self.current = start

    def __iter__(self):
        return self

    def __next__(self):
        if self.current <= 0:
            raise StopIteration
        self.current -= 1
        return self.current + 1


def first_n(iterable, n: int) -> list:
    return list(islice(iterable, n))
