%%% tests
from checker import test, eq
from solution import *


@test("group_by_length")
def _():
    eq({2: ["hi", "yo"], 3: ["abc"]}, group_by_length(["hi", "abc", "yo"]))
    eq({}, group_by_length([]))


@test("unique_tags")
def _():
    posts = [{"tags": ["Python", " api "]}, {"tags": ["python", "SQL"]}, {"tags": []}]
    eq(["api", "python", "sql"], unique_tags(posts))


@test("top_customers")
def _():
    orders = [("an", 100), ("binh", 300), ("an", 250), ("chi", 350), ("dung", 50)]
    eq(["an", "chi"], top_customers(orders, 2))
    eq(["an", "chi", "binh", "dung"], top_customers(orders, 10))


