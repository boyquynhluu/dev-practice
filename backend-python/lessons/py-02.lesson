@test("char_freq")
def _():
    eq([("l", 3), ("o", 2)], char_freq("Hello World", 2))
%%% solution
from collections import Counter, defaultdict


def group_by_length(words: list[str]) -> dict[int, list[str]]:
    groups = defaultdict(list)
    for w in words:
        groups[len(w)].append(w)
    return dict(groups)


def unique_tags(posts: list[dict]) -> list[str]:
    return sorted({t.strip().lower() for p in posts for t in p.get("tags", [])})


def top_customers(orders: list[tuple[str, int]], n: int) -> list[str]:
    totals: dict[str, int] = {}
    for name, amount in orders:
        totals[name] = totals.get(name, 0) + amount
    return sorted(totals, key=lambda c: (-totals[c], c))[:n]


def transpose(matrix: list[list[int]]) -> list[list[int]]:
    return [list(row) for row in zip(*matrix)]


def char_freq(s: str, k: int) -> list[tuple[str, int]]:
    counts = Counter(c for c in s.lower() if not c.isspace())
    return sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))[:k]
