%%% theory
## Type hints

```python
def find_user(user_id: int, *, active: bool = True) -> "User | None": ...
```

Python **không kiểm tra** type hint lúc chạy. Chúng phục vụ IDE, `mypy` và các thư viện như **Pydantic**/**FastAPI**: chính FastAPI đọc type hint để tự validate request.

## Không tin dữ liệu từ bên ngoài

Body JSON của request có thể thiếu field, sai kiểu (`"age": "20"`, `"age": true`), có thêm field lạ, hay chứa chuỗi cực dài. Vì vậy:

1. Validate ở **biên** (controller/handler), rồi chuyển thành object có kiểu rõ ràng (dataclass/Pydantic model).
2. Phần lõi chỉ làm việc với object đã hợp lệ.
3. Trả về **400** kèm lỗi **theo từng field**, để FE hiện lỗi ngay dưới ô input.
4. **Không bao giờ** trả password hay hash ra response.

## Bẫy: bool là int

`isinstance(True, int)` cho kết quả `True`. Khi validate field số nguyên, phải loại bool ra riêng: `isinstance(v, int) and not isinstance(v, bool)`.

## Enum

```python
from enum import Enum
class Role(str, Enum):
    USER = "user"
    ADMIN = "admin"

Role("admin")        # Role.ADMIN
Role("hacker")       # ValueError
```

Kế thừa `str` thì enum serialize ra JSON được ngay.

## Thực tế với Pydantic (FastAPI dùng thư viện này)

```python
class SignupRequest(BaseModel):
    email: EmailStr
    password: str = Field(min_length=8)
    age: int | None = Field(default=None, ge=13, le=120)
```

Bài này tự viết tay đúng logic đó, để bạn hiểu Pydantic làm gì ở bên trong.
%%% quiz
? `isinstance(True, int)` cho kết quả gì?
* True
- False
- Lỗi
? Response sau khi đăng ký nên chứa gì?
- Toàn bộ payload, kể cả password
* Thông tin công khai của user (id, email, role…), không có password
%%% hints
- Gom lỗi vào dict `errors`; cuối hàm nếu `errors` không rỗng thì `raise ValidationError(errors)`.
- Email: `re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", email)`, sau đó chuyển thành chữ thường.
- Password: `len >= 8`, `any(c.isdigit() ...)` và `any(c.isalpha() ...)`.
- Role: `try: Role(payload.get("role", "user")) except ValueError`.
- Field lạ: `set(payload) - ALLOWED`, mỗi field lạ báo lỗi "không được phép".
%%% starter
import re
from dataclasses import dataclass, field
from enum import Enum


class Role(str, Enum):
    USER = "user"
    ADMIN = "admin"


class ValidationError(Exception):
    def __init__(self, errors: dict[str, str]):
        super().__init__(f"Dữ liệu không hợp lệ: {errors}")
        self.errors = errors


@dataclass(frozen=True)
class SignupRequest:
    email: str
    password: str
    age: int | None = None
    role: Role = Role.USER
    tags: tuple[str, ...] = ()


ALLOWED = {"email", "password", "age", "role", "tags"}


def validate_signup(payload: dict) -> SignupRequest:
    """Quy tắc:
    - email: bắt buộc, dạng a@b.c, lưu chữ thường
    - password: bắt buộc, >= 8 ký tự, có cả chữ và số
    - age: không bắt buộc; nếu có phải là int (không phải bool) trong 13..120
    - role: không bắt buộc, mặc định "user"; phải thuộc Role
    - tags: không bắt buộc; list các str, tối đa 5, không trùng
    - field lạ -> lỗi "không được phép"
    Gom tất cả lỗi vào ValidationError.errors (key = tên field)."""
    return SignupRequest(payload.get("email"), payload.get("password"))  # TODO


def handle_signup(payload: dict, next_id: int) -> tuple[int, dict]:
    """(201, {"id", "email", "role", "age", "tags"}) hoặc (400, {"errors": {...}}). KHÔNG trả password."""
    return 500, {}  # TODO
%%% tests
from checker import test, eq, ok, raises
from solution import *

GOOD = {"email": "An@Mail.VN", "password": "abc12345"}


@test("payload hợp lệ tối thiểu, có giá trị mặc định")
def _():
    r = validate_signup(GOOD)
    eq("an@mail.vn", r.email)
    eq(Role.USER, r.role)
    eq(None, r.age)
    eq((), r.tags)


@test("payload đầy đủ")
def _():
    r = validate_signup({**GOOD, "age": 20, "role": "admin", "tags": ["be", "fe"]})
    eq(Role.ADMIN, r.role)
    eq(20, r.age)
    eq(("be", "fe"), r.tags)


@test("gom đủ lỗi các field")
def _():
    e = raises(ValidationError, validate_signup, {"email": "sai", "password": "short", "age": 5, "role": "hacker"})
    eq({"email", "password", "age", "role"}, set(e.errors))


@test("thiếu field bắt buộc")
def _():
    e = raises(ValidationError, validate_signup, {})
    eq({"email", "password"}, set(e.errors))


@test("password phải có chữ và số")
def _():
    raises(ValidationError, validate_signup, {**GOOD, "password": "abcdefgh"})
    raises(ValidationError, validate_signup, {**GOOD, "password": "12345678"})


@test("age kiểu bool hoặc chuỗi là sai kiểu")
def _():
    raises(ValidationError, validate_signup, {**GOOD, "age": True})
    raises(ValidationError, validate_signup, {**GOOD, "age": "20"})


@test("tags: tối đa 5, không trùng, phải là str")
def _():
    raises(ValidationError, validate_signup, {**GOOD, "tags": ["a"] * 2})
    raises(ValidationError, validate_signup, {**GOOD, "tags": list("abcdef")})
    raises(ValidationError, validate_signup, {**GOOD, "tags": [1]})


@test("field lạ bị từ chối")
def _():
    e = raises(ValidationError, validate_signup, {**GOOD, "is_admin": True})
    ok("is_admin" in e.errors, f"errors = {e.errors}")


@test("handle_signup 201 không lộ password")
def _():
    status, body = handle_signup({**GOOD, "age": 30}, next_id=7)
    eq(201, status)
    eq({"id": 7, "email": "an@mail.vn", "role": "user", "age": 30, "tags": []}, body)


@test("handle_signup 400 kèm lỗi")
def _():
    status, body = handle_signup({"email": "x"}, next_id=1)
    eq(400, status)
    ok("email" in body["errors"] and "password" in body["errors"], f"body = {body}")
%%% solution
import re
from dataclasses import dataclass, field
from enum import Enum


class Role(str, Enum):
    USER = "user"
    ADMIN = "admin"


class ValidationError(Exception):
    def __init__(self, errors: dict[str, str]):
        super().__init__(f"Dữ liệu không hợp lệ: {errors}")
        self.errors = errors


@dataclass(frozen=True)
class SignupRequest:
    email: str
    password: str
    age: int | None = None
    role: Role = Role.USER
    tags: tuple[str, ...] = ()


ALLOWED = {"email", "password", "age", "role", "tags"}


def validate_signup(payload: dict) -> SignupRequest:
    errors: dict[str, str] = {}
    for k in set(payload) - ALLOWED:
        errors[k] = "không được phép"

    email = payload.get("email")
    if not isinstance(email, str) or not re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", email):
        errors["email"] = "email không hợp lệ"

    password = payload.get("password")
    if not isinstance(password, str) or len(password) < 8 \
            or not any(c.isdigit() for c in password) or not any(c.isalpha() for c in password):
        errors["password"] = "tối thiểu 8 ký tự, gồm cả chữ và số"

    age = payload.get("age")
    if age is not None and (not isinstance(age, int) or isinstance(age, bool) or not 13 <= age <= 120):
        errors["age"] = "phải là số nguyên 13..120"

    role = Role.USER
    try:
        role = Role(payload.get("role", "user"))
    except ValueError:
        errors["role"] = "role không hợp lệ"

    tags = payload.get("tags", [])
    if not isinstance(tags, list) or not all(isinstance(t, str) for t in tags):
        errors["tags"] = "phải là danh sách chuỗi"
    elif len(tags) > 5:
        errors["tags"] = "tối đa 5 tag"
    elif len(set(tags)) != len(tags):
        errors["tags"] = "tag bị trùng"

    if errors:
        raise ValidationError(errors)
    return SignupRequest(email.lower(), password, age, role, tuple(tags))


def handle_signup(payload: dict, next_id: int) -> tuple[int, dict]:
    try:
        req = validate_signup(payload)
    except ValidationError as e:
        return 400, {"errors": e.errors}
    return 201, {"id": next_id, "email": req.email, "role": req.role.value, "age": req.age, "tags": list(req.tags)}
