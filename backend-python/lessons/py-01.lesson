%%% tests
from checker import test, eq, ok
from solution import *


@test("normalize_name gom khoảng trắng + viết hoa")
def _():
    eq("Nguyễn Văn An", normalize_name("  nguyễn   văn AN "))
    eq("", normalize_name("   "))


@test("is_palindrome")
def _():
    eq(True, is_palindrome("A man, a plan, a canal: Panama"))
    eq(False, is_palindrome("race a car"))
    eq(True, is_palindrome(""))


