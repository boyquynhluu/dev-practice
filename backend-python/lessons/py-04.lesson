%%% tests
from decimal import Decimal

from checker import test, eq, ok, raises
from solution import *


@test("Money chuẩn hoá và __str__")
def _():
    eq("10.50 USD", str(Money(Decimal("10.5"))))
    eq(Money(Decimal("10.5")), Money(Decimal("10.50")))


@test("Money validate")
def _():
    raises(ValueError, Money, Decimal("-1"))
    raises(ValueError, Money, Decimal("1"), "usd")


@test("Money + và *")
def _():
    a = Money(Decimal("1.25"))
    eq("3.75 USD", str(a * 3))
    eq("2.50 USD", str(a + a))
    raises(ValueError, lambda: a + Money(Decimal("1"), "EUR"))
    raises(TypeError, lambda: a + 5)


@test("Money hash được (frozen)")
def _():
    eq(1, len({Money(Decimal("1")), Money(Decimal("1.00"))}))


@test("Cart cộng dồn, len, in, total")
def _():
    c = Cart()
    c.add("A", Money(Decimal("10")), 2)
    c.add("B", Money(Decimal("2.5")))
    c.add("A", Money(Decimal("10")), 1)
    eq(4, len(c))
    ok("A" in c and "Z" not in c, "__contains__ sai")
    eq("32.50 USD", str(c.total()))
    eq([("A", 3), ("B", 1)], list(c))


@test("Cart remove và validate")
def _():
    c = Cart()
    raises(ValueError, c.add, "A", Money(Decimal("1")), 0)
    c.add("A", Money(Decimal("1")))
    c.remove("A")
    eq(0, len(c))
    raises(KeyError, c.remove, "A")
%%% solution
from dataclasses import dataclass, field
from decimal import ROUND_HALF_UP, Decimal


@dataclass(frozen=True)
class Money:
    amount: Decimal
    currency: str = "USD"

    def __post_init__(self):
        amount = Decimal(self.amount)
        if amount < 0:
            raise ValueError("amount phải >= 0")
        if not (isinstance(self.currency, str) and len(self.currency) == 3 and self.currency.isupper()):
            raise ValueError(f"currency không hợp lệ: {self.currency!r}")
        object.__setattr__(self, "amount", amount.quantize(Decimal("0.01"), ROUND_HALF_UP))

    def __add__(self, other):
        if not isinstance(other, Money):
            return NotImplemented
        if other.currency != self.currency:
            raise ValueError("khác loại tiền")
        return Money(self.amount + other.amount, self.currency)

    def __mul__(self, factor):
        if not isinstance(factor, int):
            return NotImplemented
        return Money(self.amount * factor, self.currency)

    def __str__(self):
        return f"{self.amount} {self.currency}"


class Cart:
    def __init__(self):
        self._items = {}

    def add(self, sku: str, price: Money, qty: int = 1) -> None:
        if qty <= 0:
            raise ValueError("qty phải > 0")
        _, cur = self._items.get(sku, (price, 0))
        self._items[sku] = (price, cur + qty)

    def remove(self, sku: str) -> None:
        del self._items[sku]

    def total(self) -> Money:
        result = Money(Decimal("0"))
        for price, qty in self._items.values():
            result = result + price * qty
        return result

    def __len__(self):
        return sum(qty for _, qty in self._items.values())

    def __contains__(self, sku):
        return sku in self._items

    def __iter__(self):
        return ((sku, qty) for sku, (_, qty) in self._items.items())
