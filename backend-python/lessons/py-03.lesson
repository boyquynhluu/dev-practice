def _():
    eq("https://api.x/v1/users?page=2", build_url("https://api.x/", "/v1/", "users", page=2, q=None))
    eq("https://api.x", build_url("https://api.x/"))
    eq("https://a.b/c?x=1&y=2", build_url("https://a.b", "c", x=1, y=2))
%%% solution
def add_item(item, bucket=None):
    if bucket is None:
        bucket = []
    bucket.append(item)
    return bucket


def _merge(a: dict, b: dict) -> dict:
    out = dict(a)
    for k, v in b.items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = _merge(out[k], v)
        else:
            out[k] = v
    return out


def merge_config(*configs: dict, **overrides) -> dict:
    result: dict = {}
    for c in (*configs, overrides):
        result = _merge(result, c)
    return result


def make_multiplier(n):
    def mul(x):
        return x * n
    return mul


def pipe(*fns):
    def run(x):
        for f in fns:
            x = f(x)
        return x
    return run


def build_url(base: str, *paths, **query) -> str:
    url = "/".join([base.rstrip("/"), *(p.strip("/") for p in paths)])
    params = "&".join(f"{k}={v}" for k, v in query.items() if v is not None)
    return f"{url}?{params}" if params else url
