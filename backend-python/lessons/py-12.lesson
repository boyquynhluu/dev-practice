%%% theory
## Framework làm gì bên dưới?

Flask và Django đều là ứng dụng **WSGI**: một callable nhận `environ` (dict mô tả request) và `start_response`, rồi trả về body dạng bytes.

```python
def app(environ, start_response):
    method = environ["REQUEST_METHOD"]          # "GET"
    path = environ["PATH_INFO"]                 # "/todos/1"
    query = environ.get("QUERY_STRING", "")     # "done=true"
    length = int(environ.get("CONTENT_LENGTH") or 0)
    body = environ["wsgi.input"].read(length)
    start_response("200 OK", [("Content-Type", "application/json; charset=utf-8")])
    return [b'{"ok": true}']
```

FastAPI chạy trên **ASGI**, bản async của WSGI, nhưng ý tưởng vẫn y như vậy.

## Quy ước REST cần làm đúng

| Request | Thành công | Lỗi |
|---|---|---|
| `GET /todos?done=true` | 200 + list | |
| `POST /todos` | **201** + header `Location: /todos/{id}` | 400 nếu JSON hỏng hoặc thiếu title |
| `GET /todos/{id}` | 200 | 404 |
| `PATCH /todos/{id}` | 200 + object mới | 400 / 404 |
| `DELETE /todos/{id}` | **204**, body rỗng | 404 |
| Path đúng nhưng method sai | | **405** + header `Allow` |

- **PATCH** chỉ cập nhật những field được gửi lên, còn **PUT** thay thế toàn bộ object.
- Lỗi cũng trả về JSON: `{"error": "..."}`, để FE xử lý theo cùng một cách.

## Test không cần server

Ứng dụng WSGI là một hàm, nên test chỉ cần gọi thẳng hàm đó với một `environ` giả lập. Không cần mở port. `wsgiref.util.setup_testing_defaults` sẽ điền sẵn các key bắt buộc.

> Bài này có sẵn helper đọc và ghi JSON. Bạn viết phần routing và logic xử lý.
%%% quiz
? `DELETE` thành công và không trả body thì dùng status nào?
- 200
* 204
- 202
? Gọi `PUT /todos` (route chỉ hỗ trợ GET và POST) nên trả gì?
- 404
* 405 kèm header Allow
- 400
%%% hints
- Tách path: `parts = [p for p in path.split("/") if p]`. Ta có `["todos"]` hoặc `["todos", "3"]`.
- Lọc theo query: `urllib.parse.parse_qs(query).get("done", [None])[0]`.
- POST: nếu `read_json` ném `ValueError` thì trả 400; `title` phải là chuỗi khác rỗng.
- id không phải số thì trả 404.
%%% starter
import json
from urllib.parse import parse_qs

STATUS = {200: "200 OK", 201: "201 Created", 204: "204 No Content", 400: "400 Bad Request",
          404: "404 Not Found", 405: "405 Method Not Allowed"}


def read_json(environ) -> dict:
    """Đọc body JSON; hỏng -> ValueError."""
    length = int(environ.get("CONTENT_LENGTH") or 0)
    raw = environ["wsgi.input"].read(length) if length else b""
    data = json.loads(raw or b"null")
    if not isinstance(data, dict):
        raise ValueError("body phải là JSON object")
    return data


def respond(start_response, status: int, body=None, headers=()):
    payload = b"" if body is None else json.dumps(body, ensure_ascii=False).encode("utf-8")
    start_response(STATUS[status], [("Content-Type", "application/json; charset=utf-8"), *headers])
    return [payload]


class TodoApp:
    def __init__(self):
        self.todos: dict[int, dict] = {}   # id -> {"id", "title", "done"}
        self.next_id = 1

    def __call__(self, environ, start_response):
        method, path = environ["REQUEST_METHOD"], environ.get("PATH_INFO", "/")
        # TODO: routing theo bảng trong phần lý thuyết
        return respond(start_response, 404, {"error": "Không tìm thấy"})
%%% tests
import io
import json
from wsgiref.util import setup_testing_defaults

from checker import test, eq, ok
from solution import *


def call(app, method, path, body=None, raw=None, query=""):
    data = raw if raw is not None else (json.dumps(body).encode() if body is not None else b"")
    env = {"REQUEST_METHOD": method, "PATH_INFO": path, "QUERY_STRING": query,
           "CONTENT_LENGTH": str(len(data)), "wsgi.input": io.BytesIO(data)}
    setup_testing_defaults(env)
    captured = {}

    def start_response(status, headers):
        captured["status"] = int(status.split()[0])
        captured["headers"] = dict(headers)

    out = b"".join(app(env, start_response))
    return captured["status"], captured["headers"], (json.loads(out) if out else None)


@test("POST tạo todo -> 201 + Location")
def _():
    app = TodoApp()
    status, headers, body = call(app, "POST", "/todos", {"title": "Học WSGI"})
    eq(201, status)
    eq({"id": 1, "title": "Học WSGI", "done": False}, body)
    eq("/todos/1", headers.get("Location"))


@test("POST JSON hỏng / thiếu title -> 400")
def _():
    app = TodoApp()
    eq(400, call(app, "POST", "/todos", raw=b"{bad")[0])
    eq(400, call(app, "POST", "/todos", {"title": "  "})[0])
    eq(400, call(app, "POST", "/todos", {})[0])


@test("GET list + lọc ?done=true")
def _():
    app = TodoApp()
    call(app, "POST", "/todos", {"title": "a"})
    call(app, "POST", "/todos", {"title": "b"})
    call(app, "PATCH", "/todos/2", {"done": True})
    eq(2, len(call(app, "GET", "/todos")[2]))
    eq([2], [t["id"] for t in call(app, "GET", "/todos", query="done=true")[2]])
    eq([1], [t["id"] for t in call(app, "GET", "/todos", query="done=false")[2]])


@test("GET /todos/{id}: 200 / 404 / id lạ")
def _():
    app = TodoApp()
    call(app, "POST", "/todos", {"title": "a"})
    eq(200, call(app, "GET", "/todos/1")[0])
    eq(404, call(app, "GET", "/todos/9")[0])
    eq(404, call(app, "GET", "/todos/abc")[0])


@test("PATCH chỉ đổi field được gửi")
def _():
    app = TodoApp()
    call(app, "POST", "/todos", {"title": "a"})
    status, _, body = call(app, "PATCH", "/todos/1", {"done": True})
    eq(200, status)
    eq({"id": 1, "title": "a", "done": True}, body)
    eq(404, call(app, "PATCH", "/todos/5", {"done": True})[0])


@test("DELETE -> 204 body rỗng, lần 2 -> 404")
def _():
    app = TodoApp()
    call(app, "POST", "/todos", {"title": "a"})
    status, _, body = call(app, "DELETE", "/todos/1")
    eq(204, status)
    eq(None, body)
    eq(404, call(app, "DELETE", "/todos/1")[0])


@test("method sai -> 405 + Allow; route lạ -> 404")
def _():
    app = TodoApp()
    status, headers, _ = call(app, "PUT", "/todos")
    eq(405, status)
    ok("POST" in headers.get("Allow", "") and "GET" in headers.get("Allow", ""), f"Allow = {headers.get('Allow')}")
    eq(404, call(app, "GET", "/users")[0])
%%% solution
import json
from urllib.parse import parse_qs

STATUS = {200: "200 OK", 201: "201 Created", 204: "204 No Content", 400: "400 Bad Request",
          404: "404 Not Found", 405: "405 Method Not Allowed"}


def read_json(environ) -> dict:
    length = int(environ.get("CONTENT_LENGTH") or 0)
    raw = environ["wsgi.input"].read(length) if length else b""
    data = json.loads(raw or b"null")
    if not isinstance(data, dict):
        raise ValueError("body phải là JSON object")
    return data


def respond(start_response, status: int, body=None, headers=()):
    payload = b"" if body is None else json.dumps(body, ensure_ascii=False).encode("utf-8")
    start_response(STATUS[status], [("Content-Type", "application/json; charset=utf-8"), *headers])
    return [payload]


class TodoApp:
    def __init__(self):
        self.todos: dict[int, dict] = {}
        self.next_id = 1

    def __call__(self, environ, start_response):
        method, path = environ["REQUEST_METHOD"], environ.get("PATH_INFO", "/")
        parts = [p for p in path.split("/") if p]
        if not parts or parts[0] != "todos" or len(parts) > 2:
            return respond(start_response, 404, {"error": "Không tìm thấy"})
        if len(parts) == 1:
            if method == "GET":
                return self._list(environ, start_response)
            if method == "POST":
                return self._create(environ, start_response)
            return respond(start_response, 405, {"error": "Method không hỗ trợ"}, [("Allow", "GET, POST")])

        todo = self.todos.get(int(parts[1])) if parts[1].isdigit() else None
        if method not in ("GET", "PATCH", "DELETE"):
            return respond(start_response, 405, {"error": "Method không hỗ trợ"}, [("Allow", "GET, PATCH, DELETE")])
        if todo is None:
            return respond(start_response, 404, {"error": "Không có todo"})
        if method == "GET":
            return respond(start_response, 200, todo)
        if method == "DELETE":
            del self.todos[todo["id"]]
            return respond(start_response, 204)
        try:
            data = read_json(environ)
        except ValueError:
            return respond(start_response, 400, {"error": "JSON không hợp lệ"})
        if "title" in data:
            if not isinstance(data["title"], str) or not data["title"].strip():
                return respond(start_response, 400, {"error": "title không hợp lệ"})
            todo["title"] = data["title"].strip()
        if "done" in data:
            if not isinstance(data["done"], bool):
                return respond(start_response, 400, {"error": "done phải là boolean"})
            todo["done"] = data["done"]
        return respond(start_response, 200, todo)

    def _list(self, environ, start_response):
        done = parse_qs(environ.get("QUERY_STRING", "")).get("done", [None])[0]
        items = list(self.todos.values())
        if done in ("true", "false"):
            items = [t for t in items if t["done"] == (done == "true")]
        return respond(start_response, 200, items)

    def _create(self, environ, start_response):
        try:
            data = read_json(environ)
        except ValueError:
            return respond(start_response, 400, {"error": "JSON không hợp lệ"})
        title = data.get("title")
        if not isinstance(title, str) or not title.strip():
            return respond(start_response, 400, {"error": "title là bắt buộc"})
        todo = {"id": self.next_id, "title": title.strip(), "done": False}
        self.todos[todo["id"]] = todo
        self.next_id += 1
        return respond(start_response, 201, todo, [("Location", f"/todos/{todo['id']}")])
